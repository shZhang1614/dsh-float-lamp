{
  "name": "dsh-float-lamp",
  "version": "0.3.1",
  "description": "悬浮发光状态灯：实时显示 DSH 任务状态（绿=运行中，橙=待授权，蓝=待交互，灰=空闲，暗灰=宿主离线），全透明背景+呼吸光晕动画，灯窗独立于 DSH 应用窗口。",
  "license": "MIT",
  "author": "shZhang1614",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shZhang1614/dsh-float-lamp.git"
  },
  "bugs": {
    "url": "https://github.com/shZhang1614/dsh-float-lamp/issues"
  },
  "homepage": "https://github.com/shZhang1614/dsh-float-lamp",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "status-lamp",
    "float-window"
  ],
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "widget",
    "cordis.patch.yml",
    "screenshots.json",
    "screenshots",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18"
  }
}
